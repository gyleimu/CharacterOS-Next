{
  "name": "characteros-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 --if-present run build",
    "governance": "node scripts/governance-check.mjs",
    "interactive": "pnpm --filter @characteros-next/sandbox build && pnpm --filter @characteros-next/sandbox interactive",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:workspaces",
    "typecheck:auxiliary": "tsc -p tsconfig.auxiliary.json",
    "typecheck:workspaces": "tsc -p tsconfig.workspaces.json",
    "verify": "pnpm governance && pnpm typecheck && pnpm build && pnpm typecheck:auxiliary && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
